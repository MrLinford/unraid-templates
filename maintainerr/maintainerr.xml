<?xml version="1.0"?>
<Container version="2">
  <Name>Maintainerr</Name>
  <Repository>maintainerr/maintainerr:main</Repository>
  <Registry>https://hub.docker.com/r/maintainerr/maintainerr</Registry>
  <Network>net_main</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/jorenn92/Maintainerr/issues?q=is%3Aissue+is%3Aopen+sort%3Aupdated-desc</Support>
  <Project>https://github.com/Maintainerr/Maintainerr</Project>
  <ReadMe/>
  <Overview>Maintainerr makes managing your media easy. Create custom rules with parameters across different services, show matching media on the Plex home screen for a given amount of days and handle the deletion.</Overview>
  <Category>Productivity: Tools: Other: MediaApp:Video MediaServer:Video</Category>
  <WebUI>http://[IP]:[PORT:6246]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Droppisalt/unraid-templates/main/maintainerr/maintainerr.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/Maintainerr/Maintainerr/refs/heads/development/apps/ui/public/logo.png</Icon>
  <ExtraParams>-u 99:100</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1776536564</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI" Target="6246" Default="" Mode="tcp" Description="" Type="Port" Display="always" Required="false" Mask="false">6246</Config>
  <Config Name="Data" Target="/opt/data" Default="" Mode="rw" Description="" Type="Path" Display="always" Required="false" Mask="false">/mnt/cache/appdata/maintainerr</Config>
  <Config Name="Timezone" Target="TZ" Default="" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">Europe/London</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID for the container (Default 99 for 'nobody')" Type="Variable" Display="advanced-hide" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID for the container (Default 100 for 'users')" Type="Variable" Display="advanced-hide" Required="true" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="022" Mode="" Description="UMASK for file permissions" Type="Variable" Display="advanced-hide" Required="true" Mask="false">022</Config>
  <TailscaleStateDir/>
</Container>
